{
    "name":  "dsh-memory-nebula-bridge",
    "version":  "0.2.0",
    "type":  "module",
    "description":  "Bridge a memory-nebula store into DeepSeek Harness: a 3D memory-graph entry in the sidebar plus three agent tools to inspect, search and revise memories. 把「记忆星云」记忆库接进 DSH：侧栏三维星云入口 + 三个智能体记忆工具。",
    "keywords":  [
                     "dsh",
                     "deepseek-harness",
                     "memory",
                     "memory-nebula",
                     "plugin"
                 ],
    "license":  "MIT",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.md"
              ],
    "scripts":  {
                    "test":  "node test/smoke.mjs",
                    "test:host":  "node test/host.mjs"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [

                                          ]
                           }
            },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/2930136787xy-tech/dsh-memory-nebula-bridge.git"
                   }
}