{
  "name": "dsh-memory-nebula-bridge",
  "version": "0.3.0",
  "type": "module",
  "description": "Give DeepSeek Harness its own memory: a self-hosted memory store it can recall from, write to, and show as a 3D star map — no chat app required. 给 DSH 一份属于使用者自己的记忆：能想起来、能记住、能看见，不需要任何聊天软件。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "memory-nebula",
    "plugin"
  ],
  "license": "MIT",
  "homepage": "https://github.com/2930136787xy-tech/dsh-memory-nebula-bridge#readme",
  "bugs": {
    "url": "https://github.com/2930136787xy-tech/dsh-memory-nebula-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2930136787xy-tech/dsh-memory-nebula-bridge.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "framework/**",
    "test/smoke.mjs",
    "test/host.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:host": "node test/host.mjs"
  }
}