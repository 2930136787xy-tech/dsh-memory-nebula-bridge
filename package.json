{
  "name": "dsh-memory-nebula-bridge",
  "version": "0.2.0",
  "type": "module",
  "description": "Bridge a memory-nebula store into DeepSeek Harness: an in-UI panel to search, edit, pin and forget memories, plus three agent tools. 把「记忆星云」记忆库接进 DSH：页面内记忆面板 + 三个智能体工具。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "memory-nebula",
    "plugin"
  ],
  "license": "MIT",
  "homepage": "https://github.com/2930136787xy-tech/dsh-memory-nebula-bridge#readme",
  "bugs": {
    "url": "https://github.com/2930136787xy-tech/dsh-memory-nebula-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2930136787xy-tech/dsh-memory-nebula-bridge.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:host": "node test/host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}